{
  "name": "netflix-more-subs",
  "version": "1.9.0",
  "private": true,
  "description": "Dual Subtitles for Netflix - Chrome extension",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:dev": "DEV=1 node scripts/build.mjs",
    "fixture": "node scripts/serve-fixture.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,mjs,ts,html,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,ts,html,json,md}\"",
    "typecheck": "tsc --noEmit",
    "smoke:snippet": "node scripts/smoke/snippet.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/junseok-oh-0/netflix-more-subs.git"
  },
  "license": "GPL-3.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
